# --- Gemini «Nano Banana» ---
# Ключ из Google AI Studio (https://aistudio.google.com/apikey). Без ключа работает STUB-режим.
GEMINI_API_KEY=
# «Nano Banana» = gemini-2.5-flash-image ; «Nano Banana Pro» = gemini-3-pro-image-preview
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
VARIANTS=3

# --- Резерв: Replicate (FLUX Kontext Pro), ADR-6 ---
# Токен: https://replicate.com/account/api-tokens . Пусто → резерв выключен.
REPLICATE_API_TOKEN=

# --- Печать (CUPS/lpr) ---
# 0 = карточка только сохраняется; 1 = реально печатать. Имя принтера — из `lpstat -p`.
PRINT_ENABLED=0
# Ключ страницы очереди печати /print-queue?key=... (для оператора у принтера).
# Пусто — страница выключена и отдаёт 404.
PRINT_QUEUE_KEY=
PRINT_PRINTER=

# --- QR / цифровая версия ---
PUBLIC_BASE_URL=http://localhost:8000
DIGITAL_TTL_HOURS=72

# --- Email: отправка карточки гостю (Яндекс SMTP) ---
# Пароль приложения: Яндекс ID → Безопасность → Пароли приложений → Почта
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Режим генерации и качество лица (значения рабочего киоска) ---
# edit — модель заново пишет сцену по эталону, поэтому посторонние люди и
# водяные знаки, оставшиеся на исходных фото локаций, в кадр не попадают.
# composite вклеивает вырезанного гостя в эталон как есть, вместе со всем,
# что на эталоне уже нарисовано. На форуме работал edit.
GEN_MODE=edit
# Вебка даёт лицо 250-420 px. Значение по умолчанию в коде — 512, с ним
# гость получает «Подойдите ближе» почти на каждом кадре.
FACE_MIN_PX=250
# Слабый кадр с вебки чистится GFPGAN: шум и мыло уходят, лицо резче.
FACE_ENHANCE=1
# Выравнивание света: убирает тени от верхнего освещения на лице.
FACE_DESHADOW=1
# Перенос настоящего лица гостя на готовый кадр — заметно поднимает сходство.
FACE_SWAP=1
